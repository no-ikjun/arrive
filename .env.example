# 함께 도착 — 로컬 설정
# 실제 값은 .env.local에 입력하세요. .env.example에는 비밀값을 넣지 마세요.
# 현재 필요한 입력: PLEOS_PROJECT_ID (콘솔의 프로젝트 ID/Key, 로컬 기록용)
PLEOS_PROJECT_ID=

# 선택: 향후 서버 기반 STT/TTS SDK용. 현재 NaviHelper/Vehicle State에는 불필요.
# 두 값 모두 앱 BuildConfig/APK에 포함하지 않습니다.
PLEOS_CLIENT_ID=
PLEOS_CLIENT_SECRET=

# Android Emulator에서 개발 컴퓨터의 백엔드에 접근하는 주소입니다.
# 아직 백엔드 연결 기능이 없으므로 기본값 그대로 두세요.
ARRIVAL_API_BASE_URL=http://10.0.2.2:8080

# 동승자 웹을 배포한 뒤 입력. 아직은 비워 두세요.
ARRIVAL_COMPANION_BASE_URL=
