{
  "name": "arrive-together-backend",
  "version": "0.1.0",
  "private": true,
  "description": "함께 도착 방문 세션 공유 API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config jest.config.cjs",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --ci --config jest.config.cjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node dist/persistence/migrate-cli.js",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config jest.config.cjs --testPathPattern=src/",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config jest.config.cjs --testPathPattern=test/"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
