# --- Docker Compose Postgres (backend/.env 에 복사 후 실제 값으로 변경) ---
POSTGRES_USER=DATABASE_USER
POSTGRES_PASSWORD=DATABASE_PASSWORD
POSTGRES_DB=DATABASE_NAME

# 로컬에서 호스트의 Postgres(compose 가 5432 를 연다)에 붙을 때.
# 이 줄을 비우면 npm start / npm test 는 임베디드 Postgres(PGlite)를 사용합니다.
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@localhost:5432/DATABASE_NAME
# 서버 시크릿 ENV_FILE 에서는 호스트를 postgres, PORT 를 3000 으로 둡니다.
# DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@postgres:5432/DATABASE_NAME
# PORT=3000

# 로컬 npm start 기본 포트. Docker Compose / 배포 컨테이너는 3000 입니다.
PORT=8080

# 32-byte key encoded as base64. This placeholder is not a secret and will not start the server.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace-me-with-base64-of-32-random-bytes
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CLEANUP_INTERVAL_MS=60000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Optional. Defaults to ../contracts/oryong-demo.json when the process cwd is backend/.
VENUE_CATALOG_PATH=
