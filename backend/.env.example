# 배포 준비 확인에 사용합니다. 서버는 gistag Postgres 안에 만든 arrive 사용자와 데이터베이스입니다.
POSTGRES_USER=arrive
POSTGRES_PASSWORD=DATABASE_PASSWORD
POSTGRES_DB=arrive

# 로컬에 설치된 Postgres(localhost:5432)에 붙을 때.
# 이 줄을 비우면 npm start / npm test 는 임베디드 Postgres(PGlite)를 사용합니다.
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@localhost:5432/DATABASE_NAME
# 서버 시크릿 ENV_FILE. 호스트 postgres는 gistag-net에 있는 gistag Postgres입니다.
# DATABASE_URL=postgresql://arrive:DATABASE_PASSWORD@postgres:5432/arrive
# PORT=3000

# 로컬 npm start 기본 포트. Docker Compose / 배포 컨테이너는 3000 입니다.
PORT=8080

# 32-byte key encoded as base64. This placeholder is not a secret and will not start the server.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace-me-with-base64-of-32-random-bytes
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CLEANUP_INTERVAL_MS=60000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Optional. When set, this index is the only catalog source. An invalid index fails startup
# and is not replaced by the single-file catalog. Docker uses /contracts/venues/index.json.
VENUE_CATALOG_INDEX_PATH=
# Used only when VENUE_CATALOG_INDEX_PATH is empty.
# Defaults to ../contracts/oryong-demo.json when the process cwd is backend/.
VENUE_CATALOG_PATH=
